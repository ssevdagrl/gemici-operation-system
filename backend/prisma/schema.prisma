generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  MANAGER
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RideStatus {
  SCHEDULED
  ON_TIME
  DELAYED
  CANCELLED
  COMPLETED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shifts      Shift[]
  auditLogs   AuditLog[]
  rideNotes   RideNote[]
  rideMarkers RideMarker[]
  officeNotes OfficeNote[]
}

model Shift {
  id             String      @id @default(uuid())
  userId         String
  scheduledStart DateTime
  scheduledEnd   DateTime
  clockedInAt    DateTime?
  clockedOutAt   DateTime?
  status         ShiftStatus @default(PLANNED)
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([scheduledStart])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Vehicle {
  id                  String    @id @default(uuid())
  plate               String    @unique
  model               String?
  callShortCode       String?   @map("shortCompanyLineCode")
  companyPhone        String?
  phone1              String?
  phone2              String?
  phone3              String?
  directoryImportedAt DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  rides               Ride[]

  @@index([callShortCode])
  @@index([companyPhone])
}

model Ride {
  id                    String     @id @default(uuid())
  externalRideId        String?    @unique
  rideDate              DateTime
  plannedDeparture      DateTime
  plannedArrival        DateTime?
  estimatedArrival      DateTime?
  origin                String
  destination           String
  platform              String?
  status                RideStatus @default(SCHEDULED)
  delayMinutes          Int        @default(0)
  kocaeliPassengerCount Int        @default(0)
  vehicleId             String?
  companyLineCode       String?

  currentLocationName String?
  currentLatitude     Float?
  currentLongitude    Float?
  locationUpdatedAt   DateTime?
  locationStatus String?

  hasPassedKocaeli Boolean @default(false)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  notes      RideNote[]
  markers    RideMarker[]
  passengers RidePassenger[]

  @@index([rideDate])
  @@index([plannedDeparture])
  @@index([origin])
  @@index([destination])
  @@index([status])
  @@index([vehicleId])
}

model RideNote {
  id        String   @id @default(uuid())
  rideId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([rideId])
  @@index([authorId])
  @@index([createdAt])
}

model RideMarker {
  id        String   @id @default(uuid())
  rideId    String
  userId    String
  isStarred Boolean  @default(false)
  isAlert   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@index([userId])
}

model RidePassenger {
  id                   String   @id @default(uuid())
  rideId               String
  fullName             String
  phone                String
  seatNumber           String?
  ticketNumber         String?
  boardingPoint        String   @default("Kocaeli Otogar")
  passengerDestination String?
  salesChannel         String?
  checkinStatus        String?
  isKocaeliPassenger   Boolean  @default(true)
  isCancelled          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([isKocaeliPassenger])
  @@index([phone])
  @@index([salesChannel])
}

model OfficeNote {
  id        String    @id @default(uuid())
  authorId  String
  content   String
  isPinned  Boolean   @default(false)
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([isPinned])
  @@index([isActive])
  @@index([createdAt])
}
